// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(cuid())
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  expenses      Expense[]
  creditCards   CreditCard[]
  budgets       Budget[]
  categories    Category[]
  recurringRules  RecurringRule[]
  pendingPayments PendingPayment[]
  savingsGoals    SavingsGoal[]
  moneyAccounts   MoneyAccount[]
  investments     Investment[]
  ledgerMoves     LedgerMove[]
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum PaymentMethod {
  CASH
  UPI
  CC
}

enum RecurringCadence {
  MONTHLY
}

enum PendingStatus {
  PENDING
  PAID
  SKIPPED
}

enum InvestmentKind {
  MF
  STOCK
  FD
  RD
  PPF
  GOLD
  SILVER
  OTHER
}

model Category {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
}

model CreditCard {
  id           String    @id @default(cuid())
  name         String
  last4        String?
  isActive     Boolean   @default(true)
  statementDay Int?
  dueDay       Int?
  createdAt    DateTime  @default(now())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses     Expense[]
  payments     LedgerMove[]
}

model Budget {
  id       String @id @default(cuid())
  amount   Float
  month    String
  category String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
}

model Expense {
  id            String          @id @default(cuid())
  title         String
  amount        Float
  createdAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id])
  userId        String
  category      String
  type          TransactionType @default(DEBIT)
  paymentMethod PaymentMethod?
  cardId        String?
  card          CreditCard?     @relation(fields: [cardId], references: [id])
  accountId     String?
  account       MoneyAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  pendingPayment PendingPayment?
}

model RecurringRule {
  id            String           @id @default(cuid())
  title         String
  amount        Float
  category      String
  type          TransactionType  @default(DEBIT)
  paymentMethod PaymentMethod?
  cardId        String?
  accountId     String?
  investmentId  String?
  investment    Investment?      @relation(fields: [investmentId], references: [id], onDelete: SetNull)
  payee         String?
  cadence       RecurringCadence @default(MONTHLY)
  dayOfMonth    Int
  totalMonths   Int?
  isActive      Boolean          @default(true)
  startDate     DateTime         @default(now())
  createdAt     DateTime         @default(now())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendings      PendingPayment[]
}

model PendingPayment {
  id            String           @id @default(cuid())
  title         String
  amount        Float
  category      String
  type          TransactionType  @default(DEBIT)
  paymentMethod PaymentMethod?
  cardId        String?
  accountId     String?
  investmentId  String?
  payee         String?
  dueDate       DateTime
  status        PendingStatus    @default(PENDING)
  expenseId     String?          @unique
  expense       Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  ruleId        String
  rule          RecurringRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime         @default(now())
  move          LedgerMove?

  @@unique([ruleId, dueDate])
}

model SavingsGoal {
  id           String   @id @default(cuid())
  title        String?
  targetAmount Float
  savedAmount  Float    @default(0)
  deadline     DateTime
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

model MoneyAccount {
  id             String       @id @default(cuid())
  name           String
  openingBalance Float        @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  movesFrom      LedgerMove[] @relation("MoveFrom")
  movesTo        LedgerMove[] @relation("MoveTo")

  @@unique([userId, name])
}

model Investment {
  id             String           @id @default(cuid())
  name           String
  kind           InvestmentKind
  investedAmount Float            @default(0)
  currentValue   Float            @default(0)
  grams          Float?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  moves          LedgerMove[]
  rules          RecurringRule[]
}

// Account → account, account → card bill, or account → investment (SIP / RD).
model LedgerMove {
  id            String         @id @default(cuid())
  amount        Float
  note          String?
  createdAt     DateTime       @default(now())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccountId String
  fromAccount   MoneyAccount   @relation("MoveFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccountId   String?
  toAccount     MoneyAccount?  @relation("MoveTo", fields: [toAccountId], references: [id], onDelete: SetNull)
  cardId        String?
  card          CreditCard?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  investmentId  String?
  investment    Investment?    @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  pendingId     String?        @unique
  pending       PendingPayment? @relation(fields: [pendingId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
